{
  "name": "e-inventory-sqlite-starter",
  "version": "0.3.13",
  "private": true,
  "description": "E-Inventory Pro offline inventory management with E+ application identity, Owner-controlled Supervisor accounts, stock and document workflows.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win dir --x64",
    "build:win": "electron-builder --win nsis --x64",
    "build": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "E-Inventory Pro",
  "build": {
    "appId": "com.einventory.pro",
    "productName": "E-Inventory Pro",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/app-logo.png",
      "boot.js",
      "build/icon.ico",
      "index.html",
      "main.js",
      "package.json",
      "preload.js",
      "renderer.js",
      "style.css"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "E-Inventory-Pro-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "E-Inventory Pro",
      "uninstallDisplayName": "E-Inventory Pro"
    },
    "artifactName": "E-Inventory-Pro-Setup-${version}.${ext}"
  }
}
